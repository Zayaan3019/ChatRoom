# Chat server settings. Copy to .env and edit; every line is optional and the
# values shown are the defaults. `python main.py` reads these from the
# environment, and docker compose substitutes them from .env.

# Network
CHAT_HOST=0.0.0.0
CHAT_PORT=8888
CHAT_METRICS_PORT=9090

# Connection limits
CHAT_MAX_CONNECTIONS=10000
CHAT_MAX_CONNECTIONS_PER_IP=100
# Seconds of silence before an idle client is disconnected
CHAT_READ_TIMEOUT=300

# Rate limiting (token buckets; a message must pass both the user's and the IP's)
CHAT_ENABLE_RATE_LIMITING=true
CHAT_MAX_MESSAGES_PER_MINUTE=60
CHAT_MAX_MESSAGES_PER_MINUTE_PER_IP=300
CHAT_MAX_JOINS_PER_MINUTE=10
CHAT_RATE_LIMIT_BURST=10

# Protocol and input limits
# Largest frame accepted, in bytes (128 KiB)
CHAT_MAX_FRAME_SIZE=131072
CHAT_MAX_MESSAGE_LENGTH=10000
CHAT_MAX_USERNAME_LENGTH=50
CHAT_MAX_ROOM_NAME_LENGTH=100
CHAT_MAX_ROOMS_PER_USER=50
CHAT_MAX_ROOM_SIZE=1000

# Timeouts (seconds)
CHAT_AUTH_TIMEOUT=30
# A client that cannot accept a frame within this time is disconnected
CHAT_WRITE_TIMEOUT=10
CHAT_SHUTDOWN_TIMEOUT=30

# Login. open = any free username (development only); token = signed JWT
# (HS256), the username is the token's subject; password = scrypt user file.
# token and password require TLS unless CHAT_ALLOW_PLAINTEXT_AUTH=true.
# Server default: open. docker compose defaults to token.
# CHAT_AUTH_MODE=token
# CHAT_JWT_SECRET_FILE=secrets/jwt.secret
# CHAT_JWT_ISSUER=
CHAT_JWT_AUDIENCE=chat
# CHAT_USERS_FILE=users.json
CHAT_MAX_AUTH_ATTEMPTS_PER_MINUTE_PER_IP=10
CHAT_ALLOW_PLAINTEXT_AUTH=false

# TLS on the chat port (python scripts/init_secrets.py secrets creates these)
# CHAT_TLS_CERT=secrets/server.pem
# CHAT_TLS_KEY=secrets/server.key

# Behind a TCP load balancer that sends the PROXY protocol
CHAT_PROXY_PROTOCOL=false
# CHAT_TRUSTED_PROXIES=10.0.0.0/8

# Cluster mode: rooms, usernames and history shared through Redis
# CHAT_REDIS_URL=redis://localhost:6379/0
# CHAT_REDIS_PASSWORD_FILE=secrets/redis.secret
CHAT_REDIS_NAMESPACE=chat
CHAT_LEASE_SECONDS=30

# History. Clients ask for it (JOIN "history": n, or "since": id to resume);
# CHAT_HISTORY_ON_JOIN is what a JOIN without either gets.
CHAT_HISTORY_ON_JOIN=0
CHAT_HISTORY_PAGE_MAX=100
CHAT_HISTORY_RESUME_MAX=500
CHAT_HISTORY_PER_ROOM=10000
CHAT_HISTORY_TTL_DAYS=30
CHAT_MEMORY_HISTORY_PER_ROOM=200

# Logging
CHAT_LOG_LEVEL=INFO
# CHAT_LOG_FILE=chat_server.log

# Client
CHAT_CLIENT_HOST=127.0.0.1
# CHAT_CLIENT_TLS=true
# CHAT_CLIENT_TLS_CA=secrets/ca.pem
# CHAT_CLIENT_TOKEN_FILE=alice.jwt
CHAT_AUTO_RECONNECT=true
CHAT_MAX_RECONNECT_ATTEMPTS=5
CHAT_RECONNECT_DELAY=2.0

# docker compose only
# Names and IPs in the server certificate (add your domain)
CHAT_TLS_HOSTS=localhost,127.0.0.1,chat-server-1,chat-server-2,nginx
GRAFANA_ADMIN_PASSWORD=admin

# Grafana host port
GRAFANA_PORT=3000
